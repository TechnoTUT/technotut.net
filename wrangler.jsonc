{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "technotut",
  "compatibility_date": "2025-01-01",
  "main": "./.output/server/index.mjs",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
